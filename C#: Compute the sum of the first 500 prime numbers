using System;

public class Add_Prime_Number
{
    public static void Main(string[] args)
    {
        Console.WriteLine("\nSum of the first 500 prime numbers");
        int sum = 0;
        int ctr = 0;
        int n = 2;

        while (ctr < 500)
        {
            if (isPrime(n))
            {
                sum += n;
                ctr++;
            }
            n++;
        }

        Console.WriteLine(sum);
    }                          // ← Main closes HERE

    public static bool isPrime(int n)   // ← isPrime is OUTSIDE Main
    {
        if (n == 1) return false;
        if (n == 2) return true;
        int x = (int)Math.Floor(Math.Sqrt(n));
        for (int i = 2; i <= x; i++)
        {
            if (n % i == 0) return false;
        }
        return true;
    }                          // ← isPrime closes HERE

}                              // ← Class closes HERE

